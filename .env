NODE_ENV=development / production (choose base on your requirement)

DB_USERNAME=your mongodb username
DB_PASSWORD=your mongodb password

PORT=server port number
REDIS_HOST=redis host url
REDIS_PORT=redis host port number
REDIS_PASSWORD=redis host password

SESSION_SECRET_KEY=unique secret key for session

JWT_SECRET_KEY=unique secret key for jwt authentication

COOKIE_SECRET_KEY=unique secret key for cookies

MAIL_RESEND_X_API_KEY=resend api key if using resend service

MAIL_MAILTRAP_X_API_KEY=mail trap api key if using mail trap services

MAIL_GMAIL_X_API_KEY=gmail x api key
MAIL_SERVICE_SENDING_EMAIL=sending mail

COULDINARY_NAME=claudinary account name
COULDINARY_API_KEY=claudinary api key
COULDINARY_API_SECRET=claudinary api secret

BMA_EMAIL=bma_notification@yopmail.com

BASE_URL="http://localhost:3000"